{
  "name": "procesa-cloud",
  "version": "0.47.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-project.mjs && node scripts/check-tenant-sql.mjs",
    "ci": "npm run verify && npm run typecheck && npm run build",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "preview:cloudflare": "npx @opennextjs/cloudflare build && npx wrangler dev",
    "deploy:cloudflare": "npx @opennextjs/cloudflare build && npx wrangler deploy",
    "deploy:staging": "npx @opennextjs/cloudflare build && npx wrangler deploy --env staging"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.127.0"
  }
}